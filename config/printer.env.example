# Copie para config/printer.env. O arquivo real e ignorado pelo Git.
MINI_HAS_LAN_IP=192.168.1.57
LOCAL_SUBNET_PREFIX=192.168.1

# URL HTTPS publicada pelo Cloudflare Tunnel.
MINI_HAS_PUBLIC_URL=https://casa.example.com
MINI_HAS_ALLOWED_ORIGINS=https://casa.example.com
MINI_HAS_TRUST_PROXY=true
MINI_HAS_BODY_LIMIT=5mb

# Criados apenas na primeira inicializacao do banco.
MINI_HAS_ADMIN_EMAIL=voce@example.com
MINI_HAS_ADMIN_PASSWORD=troque-por-uma-senha-com-12-ou-mais-caracteres

# Clientes OAuth estaticos. Ajuste os redirectUris antes de publicar Alexa/MCP.
MINI_HAS_OAUTH_CLIENTS_JSON=[{"clientId":"alexa-mini-has","clientSecret":"troque-por-um-segredo-longo","name":"Alexa Mini-HAS","redirectUris":["https://pitangui.amazon.com/api/skill/link/SEU_ID","https://layla.amazon.com/api/skill/link/SEU_ID","https://alexa.amazon.co.jp/api/skill/link/SEU_ID"],"allowedScopes":["devices:read","devices:control","scenes:read","scenes:run"],"audience":"mini-has-alexa"},{"clientId":"mcp-mini-has","name":"Mini-HAS MCP","redirectUris":["https://localhost/callback"],"allowedScopes":["devices:read","devices:control","scenes:read","scenes:run","mcp:connect"],"audience":"mini-has-mcp"}]
ALEXA_OAUTH_AUDIENCE=mini-has-alexa
# IDs de dispositivos com nome de risco liberados conscientemente (ex.: churrasqueira).
ALEXA_ALLOWED_DEVICE_IDS=
MCP_ALLOWED_ORIGINS=https://casa.example.com
