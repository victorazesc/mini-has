# Copie para config/printer.env. O arquivo real e ignorado pelo Git.
MINI_HAS_LAN_IP=192.168.1.57
LOCAL_SUBNET_PREFIX=192.168.1

# URL HTTPS publicada pelo Cloudflare Tunnel.
MINI_HAS_PUBLIC_URL=https://casa.example.com
MINI_HAS_ALLOWED_ORIGINS=https://casa.example.com
MINI_HAS_TRUST_PROXY=true
MINI_HAS_BODY_LIMIT=5mb

# Criados apenas na primeira inicializacao do banco.
MINI_HAS_ADMIN_EMAIL=voce@example.com
MINI_HAS_ADMIN_PASSWORD=troque-por-uma-senha-com-12-ou-mais-caracteres

# Clientes OAuth estaticos. Ajuste os redirectUris antes de publicar Alexa/MCP.
MINI_HAS_OAUTH_CLIENTS_JSON=[{"clientId":"alexa-mini-has","clientSecret":"troque-por-um-segredo-longo","name":"Alexa Mini-HAS","redirectUris":["https://pitangui.amazon.com/api/skill/link/SEU_ID","https://layla.amazon.com/api/skill/link/SEU_ID","https://alexa.amazon.co.jp/api/skill/link/SEU_ID"],"allowedScopes":["devices:read","devices:control","scenes:read","scenes:run"],"audience":"mini-has-alexa"},{"clientId":"mcp-mini-has","name":"Mini-HAS MCP","redirectUris":["https://localhost/callback"],"allowedScopes":["devices:read","devices:control","scenes:read","scenes:run","mcp:connect"],"audience":"mini-has-mcp"}]
ALEXA_OAUTH_AUDIENCE=mini-has-alexa
# IDs de dispositivos com nome de risco liberados conscientemente (ex.: churrasqueira).
ALEXA_ALLOWED_DEVICE_IDS=
MCP_ALLOWED_ORIGINS=https://casa.example.com

# Gravacao segura de cameras. Sem IDs, nenhuma camera e gravada.
CAMERA_RECORDING_ENABLED=false
CAMERA_RECORDING_REQUIRED=false
CAMERA_RECORDING_DEVICE_IDS=
CAMERA_RECORDING_DIR=/var/lib/mini-has/server/camera-spool
CAMERA_RECORDING_SEGMENT_DIR=/run/mini-has-camera-segments
CAMERA_RECORDING_REQUIRE_MOUNT=false
CAMERA_RECORDING_RETENTION_DAYS=15
CAMERA_RECORDING_MAX_GB=5
CAMERA_RECORDING_MIN_FREE_GB=5
CAMERA_RECORDING_RING_BUFFER_SECONDS=600
CAMERA_ONVIF_MOTION_ENABLED=true
FFMPEG_PATH=/usr/bin/ffmpeg

# Arquivo em nuvem. Credenciais OAuth ficam somente no server/.env.
CAMERA_CLOUD_STORAGE=disabled
CAMERA_CLOUD_RETENTION_DAYS=15
CAMERA_CLOUD_LOCAL_RETENTION_HOURS=24
CAMERA_CLOUD_RETRY_MINUTES=5
GOOGLE_DRIVE_FOLDER_NAME=Mini-HAS

# IA local: so persiste pessoa, pet ou veiculo confirmado em movimento.
CAMERA_OBJECT_DETECTION_ENABLED=true
CAMERA_AI_SOCKET=/run/mini-has-camera-ai/detector.sock
CAMERA_OBJECT_DETECTOR_FPS=2
CAMERA_OBJECT_MIN_SCORE=0.40
CAMERA_OBJECT_LABELS=person,bicycle,car,motorcycle,bus,truck,cat,dog

# Segunda analise do video completo. So envia dados quando os 3 campos abaixo permitem.
# No plano gratuito, o Google pode usar entradas para melhoria e revisao humana.
CAMERA_SEMANTIC_ANALYSIS_ENABLED=false
CAMERA_SEMANTIC_CLOUD_CONSENT=false
GEMINI_API_KEY=
CAMERA_SEMANTIC_MODEL=gemini-3.6-flash
CAMERA_SEMANTIC_FALLBACK_MODEL=gemini-2.5-flash
CAMERA_SEMANTIC_VIDEO_FPS=5
CAMERA_SEMANTIC_INLINE_MAX_VIDEO_MB=13
CAMERA_SEMANTIC_MAX_VIDEO_MB=128
CAMERA_SEMANTIC_TIMEOUT_SECONDS=90
# A análise semântica classifica o evento, mas nunca apaga a gravação.
CAMERA_SEMANTIC_DISCARD_IRRELEVANT=false
