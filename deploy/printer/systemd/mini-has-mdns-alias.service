[Unit]
Description=Mini-HAS mDNS alias
Requires=avahi-daemon.service
After=avahi-daemon.service
PartOf=avahi-daemon.service

[Service]
Type=notify
NotifyAccess=main
User=mini-has-server
Group=mini-has-server
ExecStart=/usr/bin/python3 /opt/mini-has/runtime/publish-mdns-alias.py --alias=casa.local --target=printer.local
Restart=on-failure
RestartSec=5
TimeoutStartSec=20
TimeoutStopSec=10
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=

CPUQuota=10%
MemoryMax=64M
TasksMax=32
Nice=5

[Install]
WantedBy=multi-user.target
