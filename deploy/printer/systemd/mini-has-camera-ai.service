[Unit]
Description=Mini-HAS camera object detector
After=local-fs.target
Before=mini-has-server.service

[Service]
Type=simple
User=mini-has-server
Group=mini-has-server
WorkingDirectory=/opt/mini-has/current/server
Environment=CAMERA_OBJECT_MIN_SCORE=0.40
Environment=CAMERA_OBJECT_DETECTOR_FPS=2
Environment=CAMERA_OBJECT_LABELS=person,bicycle,car,motorcycle,bus,truck,cat,dog
EnvironmentFile=-/etc/mini-has/server.env
ExecStart=/opt/mini-has/runtime/camera-ai/bin/python /opt/mini-has/current/server/scripts/camera-object-detector.py --socket /run/mini-has-camera-ai/detector.sock --model /opt/mini-has/runtime/models/efficientdet_lite0_int8.tflite --labels /opt/mini-has/runtime/models/coco_labelmap.txt --threads 1 --minimum-score ${CAMERA_OBJECT_MIN_SCORE} --allowed-labels ${CAMERA_OBJECT_LABELS}
Restart=always
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGTERM
UMask=0027
RuntimeDirectory=mini-has-camera-ai
RuntimeDirectoryMode=0750

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
ReadWritePaths=/run/mini-has-camera-ai

CPUQuota=60%
MemoryHigh=256M
MemoryMax=384M
TasksMax=64
Nice=15
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
